{
  "name": "usiv-usage-meter",
  "version": "1.0.0",
  "description": "Medidor de uso para tu plan de Claude, por USIV.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "USIV Asesorías Tecnológicas <https://usiv.cl>",
  "homepage": "https://github.com/cfloresusiv/USIV_Usage_Meter",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "lint:firefox": "npx --yes web-ext@10 lint --source-dir .output/firefox-mv3",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  }
}
